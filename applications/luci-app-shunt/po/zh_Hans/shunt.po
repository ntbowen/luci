msgstr "还没有与 %s 相关的日志！"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:179
msgid "No client is selected, so every client is covered."
msgstr "未选择客户端，因此覆盖所有客户端。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:198
msgid "No policy is active."
msgstr "没有策略处于活动状态。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:258
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:57
msgid "No shunt config found!"
msgstr "未找到 shunt 配置！"

