msgid "Not UDP"
msgstr "非 UDP"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:126
msgid "Not a response"
msgstr "不是响应"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:122
msgid "Not an address query"
msgstr "不是地址查询"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:128
msgid "Not exactly one question"
msgstr "问题数量不恰好为一个"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:127
msgid ""
"Nothing learned yet. The service fills these from its poll cycle and from "
"observed DNS answers."
msgstr "尚未学习到任何内容。服务会通过轮询周期和观察到的 DNS 应答来填充这些条目。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:433
msgid "Observed Devices"
msgstr "观察设备"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:139
msgid ""
"Only needed when the gateway discovered from netifd is wrong. Point to point "
"interfaces need no gateway at all."
msgstr "仅当从 netifd 发现的网关不正确时才需要。点对点接口完全不需要网关。"

#: applications/luci-app-shunt/root/usr/share/luci/menu.d/luci-app-shunt.json:23
msgid "Overview"
msgstr "概览"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:136
msgid "Packets routed"
msgstr "已路由数据包"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:428
msgid "Passive DNS Observer"
msgstr "被动 DNS 观察器"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:63
#: applications/luci-app-shunt/root/usr/share/luci/menu.d/luci-app-shunt.json:31
msgid "Policies"
msgstr "策略"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:203
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:133
msgid "Policy"
msgstr "策略"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:265
msgid ""
"Policy based routing by mac, source, destination and domain. For further "
"information please check the %s."
msgstr "基于 MAC、源、目标和域名的策略路由。更多信息请查看 %s。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:370
msgid "Poll"
msgstr "轮询"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:408
msgid "Poll Interval"
msgstr "轮询间隔"

#: applications/luci-app-shunt/root/usr/share/luci/menu.d/luci-app-shunt.json:47
msgid "Processing Log"
msgstr "处理日志"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:117
msgid "Protocols"
msgstr "协议"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:429
msgid ""
"Read DNS answers as they pass the LAN device, whichever resolver produced "
"them. Required for wildcard domains, which cannot be resolved ahead of time."
msgstr "在 DNS 应答经过 LAN 设备时读取它们，无论由哪个解析器产生。通配符域名需要此功能，因为它们无法提前解析。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:135
msgid "Record length does not fit the type"
msgstr "记录长度与类型不匹配"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:249
msgid "Refresh"
msgstr "刷新"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:239
msgid "Rejected settings"
msgstr "被拒绝的设置"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:132
msgid "Reserved label type"
msgstr "保留的标签类型"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:118
msgid "Restrict to tcp, udp or both. A port without a protocol covers both."
msgstr "限制为 tcp、udp 或两者。未指定协议的端口同时包含两者。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:330
msgid "Reverse path filtering is strict"
msgstr "反向路径过滤处于严格模式"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:208
msgid "Routes"
msgstr "路由"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:207
msgid "Rules"
msgstr "规则"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:457
#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:159
msgid "Save & Restart"
msgstr "保存并重启"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:414
msgid ""
"Seconds a learned address stays in its Set. Keep this well above the poll "
"interval."
msgstr "学习到的地址在集合中保留的秒数。应明显高于轮询间隔。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:409
msgid "Seconds between poll cycles."
msgstr "轮询周期间的秒数。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:362
msgid "Service"
msgstr "服务"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:232
#: applications/luci-app-shunt/root/usr/share/luci/menu.d/luci-app-shunt.json:39
msgid "Set Reporting"
msgstr "集合报告"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:405
msgid ""
"Set rp_filter to 2 on shunt's own policy interfaces, at start and when one "
"comes up."
msgstr "在 shunt 自己的策略接口启动及上线时，将 rp_filter 设置为 2。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:390
msgid "Settings"
msgstr "设置"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:422
msgid ""
"Should be at least twice the poll interval (%d), otherwise entries expire "
"between cycles."
msgstr "应至少为轮询间隔（%d）的两倍，否则条目会在周期间过期。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:124
msgid "Single ports or ranges like 8000-8080, ANDed with the addresses below."
msgstr "单个端口或范围，例如 8000-8080，与下方地址做“与”运算。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:107
msgid "Source Addresses"
msgstr "源地址"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:112
msgid "Source MAC Addresses"
msgstr "源 MAC 地址"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:180
msgid "Static Destinations"
msgstr "静态目标"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:450
msgid "Stop"
msgstr "停止"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:332
msgid ""
"Strict rp_filter will drop shunt's marked traffic on %s. Set rp_filter to 2 "
"on the policy interface, enable rp_filter_manage to have shunt do it, or "
"loosen it box-wide; see the README."
msgstr "严格的 rp_filter 会丢弃 %s 上 shunt 的标记流量。请将策略接口的 rp_filter 设为 2，或启用 rp_filter_manage 让 shunt 处理，或在全局放宽；详情请参见 README。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:206
msgid "Table"
msgstr "表"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:434
msgid ""
"The LAN device the DNS answers cross on their way to the clients, normally "
"br-lan. One entry per network segment, see the README."
msgstr "DNS 应答传向客户端所经过的 LAN 设备，通常为 br-lan。每个网段一个条目，详情请参见 README。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:92
msgid ""
"The device or logical interface this policy routes into. A netifd name is "
"resolved to its device; any other device name is used as entered."
msgstr "此策略路由进入的设备或逻辑接口。netifd 名称会解析为其设备；其他设备名称按输入原样使用。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/logtemplate.js:44
msgid "The syslog output, pre-filtered for messages related to: %s"
msgstr "系统日志输出，已预过滤与以下内容相关的消息：%s"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:241
msgid ""
"These entries were skipped. Everything else was applied - a rejected entry "
"never takes the service down."
msgstr "这些条目已跳过。其余内容都已应用——被拒绝的条目不会导致服务停止。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:136
msgid "Too many answers"
msgstr "应答过多"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:140
msgid "Too many stacked VLAN tags"
msgstr "堆叠的 VLAN 标签过多"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:127
msgid "Truncated response"
msgstr "截断的响应"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:364
msgid "Version"
msgstr "版本"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:235
msgid ""
"What the nftables Sets currently hold. Counters are reset whenever an entry "
"is refreshed, so they show recent activity, not a lifetime total."
msgstr "nftables 集合当前持有的内容。计数器会在条目刷新时重置，因此显示的是近期活动，而非累计总量。"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/overview.js:369
msgid "across all policies"
msgstr "跨所有策略"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/setreport.js:192
msgid "all policies"
msgstr "所有策略"

#: applications/luci-app-shunt/htdocs/luci-static/resources/view/shunt/policies.js:134
msgid ""
"example.com matches that name only, *.example.com matches its subdomains but "
